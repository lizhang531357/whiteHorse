{
  "name": "ai-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "最小 React 工程：前端 React + 后端 Node 转发调 DeepSeek",
  "scripts": {
    "start": "sh ./start.sh",
    "server": "node --watch --env-file=.env server.js",
    "serve": "node --env-file=.env server.js",
    "share": "yarn build && PORT=3011 node --env-file=.env server.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3011 --no-autoupdate",
    "backup": "node scripts/backup-db.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "antd": "^4.24.16",
    "better-sqlite3": "11.10.0",
    "highlight.js": "^11.10.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "4.24.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "less": "^4.2.0",
    "rollup": "4.24.0",
    "typescript": "5.6.3",
    "vite": "^5.4.11"
  },
  "resolutions": {
    "rollup": "4.24.0",
    "@rollup/rollup-darwin-arm64": "4.24.0"
  }
}
